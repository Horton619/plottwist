{
  "name": "plottwist",
  "version": "0.1.3",
  "description": "Seating layout calculator and visualizer for live event planning — Visual Entropy Productions",
  "main": "main.js",
  "homepage": "https://veproductions.net",
  "author": {
    "name": "Visual Entropy Productions"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Horton619/plottwist.git"
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "start": "electron .",
    "build:mac:dir": "electron-builder --mac --dir",
    "build:win": "electron-builder --win --dir",
    "pack": "electron-builder --dir",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "release:mac": "electron-builder --mac --publish always",
    "release:win": "electron-builder --win --publish always"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.0"
  },
  "dependencies": {
    "electron-updater": "^6.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "polygon-clipping": "^0.15.7"
  },
  "build": {
    "appId": "net.veproductions.plottwist",
    "productName": "PlotTwist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "data/**/*",
      "!**/.DS_Store",
      "!**/*.ptwist"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Horton619",
        "repo": "plottwist"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64"] },
        { "target": "zip", "arch": ["arm64"] }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements":        "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": { "teamId": "L5KZ5KGKXC" }
    },
    "dmg": {
      "iconSize": 100,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        { "x": 175, "y": 245, "type": "file" },
        { "x": 385, "y": 245, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
